{
  "description": "Qwen3.5-0.8B batch-1 prefill of 2048 tokens: the TensorRT baseline, the recipe the agent session selected and the strongest Inductor configurations (head_to_head); the other configs are the menu they were chosen from",
  "workload": "tools/llm/qwen35_prefill.py:create_case",
  "args": {
    "model": "Qwen/Qwen3.5-0.8B",
    "length": 2048,
    "positions": 64
  },
  "reference": "reference.pt",
  "timeout_s": 3600,
  "head_to_head": [
    "trt-baseline",
    "trt-session",
    "inductor-functional-causal-tf32-fp16-fp16acc-default",
    "inductor-functional-causal-max-autotune"
  ],
  "configs": {
    "trt-baseline": {
      "recipe": {}
    },
    "trt-session": {
      "recipe": {
        "engine.disable_tf32": false,
        "engine.precision": "fp16",
        "engine.use_fp32_acc": false,
        "kernels.gdn_scan": "triton-tf32",
        "runtime.cudagraphs": true,
        "workload.attention": "causal",
        "workload.conv": "shifts",
        "workload.gdn": "functional"
      }
    },
    "trt-causal": {
      "recipe": {
        "workload.attention": "causal"
      }
    },
    "trt-functional": {
      "recipe": {
        "workload.gdn": "functional"
      }
    },
    "trt-functional-shifts": {
      "recipe": {
        "workload.gdn": "functional",
        "workload.conv": "shifts"
      }
    },
    "trt-functional-shifts-causal": {
      "recipe": {
        "workload.gdn": "functional",
        "workload.conv": "shifts",
        "workload.attention": "causal"
      }
    },
    "trt-functional-shifts-decompose-attention": {
      "recipe": {
        "workload.gdn": "functional",
        "workload.conv": "shifts",
        "engine.decompose_attention": true
      }
    },
    "trt-functional-shifts-tf32": {
      "recipe": {
        "workload.gdn": "functional",
        "workload.conv": "shifts",
        "engine.disable_tf32": false
      }
