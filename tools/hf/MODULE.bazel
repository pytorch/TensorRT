module(name = "torch_tensorrt_edge_llm", version = "0.1.0a0")

# Consume Torch-TensorRT's public native SDK, rather than importing its whole
# source build (which currently assumes it is the root Bazel module).
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "googletest", version = "1.16.0")

native_sdk = use_repo_rule("//toolchains:native_sdk.bzl", "native_sdk")
native_sdk(name = "torchtrt_native")
