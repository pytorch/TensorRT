load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "aarch64_linux",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

filegroup(
    name = "delegate_sources",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ) + [
        "//:torchtrt_cmake_modules",
        "//core/runtime:include_files",
        "//cpp:executorch_api_headers",
        "//cpp:executorch_backend_source_files",
    ],
)

# The delegate compiles and links against the installed ExecuTorch wheel, which ships the
# headers and the prebuilt runtime. ExecuTorch is not built from source here, so this target
# takes no ExecuTorch source input; CMAKE_PREFIX_PATH points find_package at the wheel.
cmake(
    name = "delegate_native",
    build_args = ["--verbose"],
    cache_entries = select({
        "//:rtx_sbsa": {
            "CMAKE_BUILD_TYPE": "Release",
            "CMAKE_PREFIX_PATH": "$${EXECUTORCH_CMAKE_PREFIX_PATH:-}",
            "PYTHON_EXECUTABLE": "$${PYTHON_BIN_PATH}",
            "TORCH_TENSORRT_EXECUTORCH_USE_RTX": "ON",
            "TORCH_TENSORRT_SOURCE_DIR": "$$EXT_BUILD_ROOT$$",
        },
        "//:rtx_x86_64": {
            "CMAKE_BUILD_TYPE": "Release",
            "CMAKE_PREFIX_PATH": "$${EXECUTORCH_CMAKE_PREFIX_PATH:-}",
            "PYTHON_EXECUTABLE": "$${PYTHON_BIN_PATH}",
            "TORCH_TENSORRT_EXECUTORCH_USE_RTX": "ON",
            "TORCH_TENSORRT_SOURCE_DIR": "$$EXT_BUILD_ROOT$$",
        },
        "//conditions:default": {
            "CMAKE_BUILD_TYPE": "Release",
            "CMAKE_PREFIX_PATH": "$${EXECUTORCH_CMAKE_PREFIX_PATH:-}",
            "PYTHON_EXECUTABLE": "$${PYTHON_BIN_PATH}",
            "TORCH_TENSORRT_SOURCE_DIR": "$$EXT_BUILD_ROOT$$",
        },
    }),
    lib_source = ":delegate_sources",
    out_include_dir = "",
    out_shared_libs = select({
        "//:rtx_sbsa": ["libexecutorch_backend_tensorrt_rtx.so"],
        "//:rtx_x86_64": ["libexecutorch_backend_tensorrt_rtx.so"],
        "//conditions:default": ["libexecutorch_backend_tensorrt.so"],
    }),
    deps = [
        "@cuda//:cudart",
    ] + select({
        "//:rtx_sbsa": ["@tensorrt_rtx_sbsa//:nvinfer"],
        "//:rtx_x86_64": ["@tensorrt_rtx//:nvinfer"],
        ":aarch64_linux": [
            "@tensorrt_sbsa//:nvinfer",
            "@tensorrt_sbsa//:nvinferplugin",
        ],
        "//conditions:default": [
            "@tensorrt//:nvinfer",
            "@tensorrt//:nvinferplugin",
        ],
    }),
)
