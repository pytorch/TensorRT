module(
    name = "torch_tensorrt",
    version = "2.16.0a0",
    repo_name = "org_pytorch_tensorrt",
)

bazel_dep(name = "googletest", version = "1.14.0")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_cc", version = "0.0.9")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

# Use the container's installed Python for wheel discovery and its local
# toolchain. A downloaded interpreter does not contain the NGC-installed wheels.
NGC_PYTHON = "python3"

local_runtime_repo = use_repo_rule("@rules_python//python/local_toolchains:repos.bzl", "local_runtime_repo")

local_runtime_repo(
    name = "ngc_python_runtime",
    dev_dependency = True,
    interpreter_path = NGC_PYTHON,
    on_failure = "fail",
)

local_runtime_toolchains_repo = use_repo_rule("@rules_python//python/local_toolchains:repos.bzl", "local_runtime_toolchains_repo")

local_runtime_toolchains_repo(
    name = "ngc_python_toolchains",
    dev_dependency = True,
    runtimes = ["ngc_python_runtime"],
)

register_toolchains(
    "@ngc_python_toolchains//:all",
    dev_dependency = True,
)

bazel_dep(name = "rules_pkg", version = "1.0.1")
git_override(
    module_name = "rules_pkg",
    commit = "17c57f4",
    remote = "https://github.com/narendasan/rules_pkg",
)

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "0e990032f3c5a866e72615cf67e5ce22186dcb97",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)

new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

new_whl_repository = use_repo_rule("//toolchains:new_whl_repository.bzl", "new_whl_repository")

torch_nccl_detect = use_repo_rule("//toolchains/torch_nccl:defs.bzl", "torch_nccl_detect")

torch_nccl_detect(name = "torch_nccl")

# External dependency for torch_tensorrt if you already have precompiled binaries.
new_whl_repository(
    name = "torch_tensorrt",
    build_file = "@//third_party/torch_tensorrt:BUILD",
    package = "torch_tensorrt",
    python = NGC_PYTHON,
)

# CUDA should be installed on the system locally
new_local_repository(
    name = "cuda",
    build_file = "@//third_party/cuda:BUILD",
    path = "/usr/local/cuda/",
)

####################################################################################
# Locally installed dependencies (use in cases of custom dependencies or aarch64)
####################################################################################

# These packages are resolved using the same Python as the NGC toolchain above.

new_whl_repository(
    name = "libtorch",
    build_file = "@//third_party/libtorch:BUILD",
    package = "torch",
    python = NGC_PYTHON,
)

# Use the source revision recorded by the pinned ExecuTorch wheel.
new_git_repository(
    name = "executorch",
    build_file = "@//third_party/executorch:BUILD",
    # executorch==1.6.0.dev20261113
    commit = "a037f680cc0877637f60bb5b5c63e204f8126e2b",
    patch_cmds = [
        "find . -mindepth 2 \\( -name BUILD -o -name BUILD.bazel \\) -delete",
        "mkdir executorch && find . -mindepth 1 -maxdepth 1 ! -name executorch ! -name BUILD ! -name BUILD.bazel ! -name REPO.bazel -exec cp -a {} executorch/ \\;",
    ],
    patch_cmds_win = [
        "Get-ChildItem -Recurse -Include BUILD,BUILD.bazel | Where-Object { $_.DirectoryName -ne (Get-Location).Path } | Remove-Item -Force",
        "New-Item -ItemType Directory executorch | Out-Null; Get-ChildItem -Force | Where-Object { $_.Name -notin @('executorch','BUILD','BUILD.bazel','REPO.bazel') } | Copy-Item -Destination executorch -Recurse -Force",
    ],
    recursive_init_submodules = True,
    remote = "https://github.com/pytorch/executorch.git",
)

# This is a workaround (WAR), not a functional Bazel repository.
# It directly references a system-installed PyTorch package, which breaks hermeticity
new_whl_repository(
    name = "torch_l4t",
    build_file = "@//third_party/libtorch:BUILD",
    package = "torch",
    python = NGC_PYTHON,
)

new_local_repository(
    name = "tensorrt",
    build_file = "@//third_party/tensorrt/local:BUILD",
    path = "/usr/",
)

new_local_repository(
    name = "tensorrt_sbsa",
    build_file = "@//third_party/tensorrt/local:BUILD",
    path = "/usr/",
)

new_local_repository(
    name = "tensorrt_l4t",
    build_file = "@//third_party/tensorrt/local:BUILD",
    path = "/usr/",
)
