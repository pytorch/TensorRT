{
  "$defs": {
    "BaseReport": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "type": "array"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "type": "string"
        },
        "report_type": {
          "const": "base"
        },
        "schema_version": {
          "const": "0.1"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "skipped"
          ],
          "type": "string"
        }
      },
      "required": [
        "report_type",
        "schema_version"
      ],
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "invalid_input",
            "unsupported_operator",
            "unsupported_environment",
            "builder_error",
            "out_of_memory",
            "timeout",
            "cancelled",
            "worker_crash",
            "serialization_error",
            "artifact_error",
            "validation_error",
            "benchmark_error",
            "internal_error"
          ],
          "type": "string"
        },
        "exception_type": {
          "type": "string"
        },
        "message": {
          "maxLength": 2048,
          "type": "string"
        },
        "retry_after_change": {
          "type": "boolean"
        },
        "retry_unchanged": {
          "type": "boolean"
        },
        "stage": {
          "enum": [
            "environment",
            "capture",
            "analysis",
            "compilation",
            "lowering",
            "partitioning",
            "conversion",
            "build",
            "serialization",
            "save",
            "validation",
            "benchmark",
            "finalization"
          ],
          "type": "string"
        },
        "suggested_actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "category",
        "message",
        "stage"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/BaseReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
